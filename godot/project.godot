config_version=5

[application]
config/name="SHIFT · 双界行者"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A nine-level puzzle platformer about two worlds and the self you leave behind."

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.075, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
